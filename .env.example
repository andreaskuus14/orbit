# --- Supabase (Project Settings → API) ---
# Like https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The anon (publishable) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- CORE runs on Claude Code under your own Claude login (no API key) ---
# Install Claude Code and run `claude` once to sign in. ORBIT must run on that same machine.
# Empty = sonnet
ORBIT_MODEL=
# Optional: model for CORE's "deep" answers to hard asks (planned, then self-checked). sonnet, opus, haiku,
# or fable / a claude-fable-* id only if your Claude plan has it. Default opus.
# ORBIT_MODEL_DEEP=opus
# Optional: Claude Code --effort for deep answers: low, medium, high, xhigh or max (empty = off). Default high.
# ORBIT_DEEP_EFFORT=high
# ORBIT_CLAUDE_BIN=claude
# Optional "local brain": an Ollama model on this PC (tools\ollama\setup.ps1 sets it; default qwen3.5:9b; Apache-2.0, 6.6 GB) that answers CORE chat and
# background summaries when Claude is unreachable, rate-limited or on the usage hold. No tools in that mode. Empty = off.
# While the GPU is busy (pictures, 3D, video) it answers with qwen3.5:4b if that is pulled; if the model is missing it uses any
# installed one and the doctor shows the pull command. Journal text never goes to any model. ORBIT_LOCAL_MODEL is the older name and still works. See tools/ollama/README.md.
ORBIT_LOCAL_LLM_MODEL=
# Ollama address. Empty = http://127.0.0.1:11434; must be this PC (anything else is ignored).
ORBIT_LOCAL_LLM_URL=
# Document OCR (scanned PDFs, photos of receipts): the glm-ocr model in the same Ollama (tools\ollama\setup.ps1 -Ocr). ORBIT_OCR=0 turns it off,
# ORBIT_OCR_MODEL picks another Ollama model (never a :cloud one), ORBIT_OCR_MAX_PAGES caps pages per file (default 20, max 50).
ORBIT_OCR=
ORBIT_OCR_MODEL=
ORBIT_OCR_MAX_PAGES=
# Feature scout (OPERATIONS → Scout): every 6 h reads Hugging Face, GitHub, the Ollama library and awesome-mcp-servers for new open models/tools
# (public metadata only, one Haiku call per batch) and lists candidates; it never installs or downloads. ORBIT_SCOUT=0 turns it off.
ORBIT_SCOUT=
# Local AI tools (Picture to 3D, voiceover, own-voice cloning) from tools/local-ai/start.ps1. Empty = http://127.0.0.1:7861.
# Must be this PC (127.0.0.1 / localhost): ORBIT refuses any other address.
ORBIT_LOCAL_AI_URL=
ORBIT_CUTOUT_MODEL=
# Local pictures (ComfyUI from tools/comfyui/setup.ps1). Empty = http://127.0.0.1:8188; must be this PC. ORBIT starts it by itself
# (ORBIT_COMFY_AUTOSTART=0 turns that off). ORBIT_LOCAL_PICTURES=0 skips it for website photos (then the online free service is used).
ORBIT_COMFY_URL=
ORBIT_COMFY_AUTOSTART=
# Empty = SDXL-Lightning. Set to nitrofusion2 after running tools\comfyui\setup.ps1 -Model nitrofusion2.
ORBIT_COMFY_MODEL=
# Local AI music for Shorts (ACE-Step 1.5 in the same ComfyUI): used automatically once tools\comfyui\setup.ps1 -Model acestep-music
# has run. "off" = skip it (music folder / ORBIT_ACESTEP_CMD only).
ORBIT_MUSIC_GEN=
# Local video (CORE local_video, tools\comfyui\setup.ps1 -Model wan22-video). 1 = quality "best" renders 1280x704 instead of 832x480 (slower, may run out of 8 GB).
ORBIT_VIDEO_HD=
# Best-quality picture → 3D (TRELLIS.2, tools/trellis/setup.ps1). Empty = http://127.0.0.1:8189; must be this PC. ORBIT starts it by itself
# (ORBIT_TRELLIS_AUTOSTART=0 turns that off).
ORBIT_TRELLIS_URL=
ORBIT_TRELLIS_AUTOSTART=
ORBIT_LOCAL_PICTURES=

# --- Embeddings (optional but recommended) ---
# Optional. Anthropic has no embedding model; its docs recommend Voyage AI. Leave blank to use the free local model.
# Without this, ORBIT still works with full-text search only and no link suggestions.
# ORBIT_EMBED: local (free model on this PC) or voyage. Empty = Voyage when VOYAGE_API_KEY is set, else local.
ORBIT_EMBED=
# ORBIT_RERANK=1 turns on the local Qwen3-Reranker-0.6B over the top 30 memory-search hits (child process, CPU, ~600 MB download on first use,
# falls back to normal ranking on any failure). ORBIT_RERANK_MS = scoring time budget per search (default 4000).
ORBIT_RERANK=
ORBIT_RERANK_MS=
VOYAGE_API_KEY=
# Empty = voyage-4
VOYAGE_MODEL=
# Empty = https://ai.mongodb.com/v1/embeddings
VOYAGE_API_URL=

# --- Scheduled briefings (Phase 2, optional) ---
# Supabase → Project Settings → API Keys → Secret keys → "default". Server-only: never share it or put it in NEXT_PUBLIC_*.
# Lets the Morning/Midday/Evening/Weekly briefings run while no browser is open. Leave blank to only brief on demand.
SUPABASE_SECRET_KEY=
# Weekly local backup folder (needs the secret key above). Default: orbit-backups next to the ORBIT folder.
ORBIT_BACKUP_DIR=
# Journal encryption key file (tools\backup\setup.ps1 makes it). Empty = %LOCALAPPDATA%\orbit\keys\journal.key. Never inside this folder.
ORBIT_JOURNAL_KEY_FILE=
# restic backup password file (setup.ps1 makes it). Empty = %LOCALAPPDATA%\orbit\keys\restic.pass. ORBIT_RESTIC = path of restic.exe if not on PATH.
ORBIT_RESTIC_PASSWORD_FILE=
ORBIT_RESTIC=

# --- Clip Factory (optional): folder with inbox/ (drop long videos here), clips/, jobs/, models/. Default: orbit-studio next to the ORBIT folder ---
ORBIT_STUDIO_DIR=
# Full path to ffmpeg.exe if you don't want the bundled ffmpeg-static one
ORBIT_FFMPEG=

# --- STUDIO channel stats + Video Scout (optional): YouTube Data API v3 key ---
# Google Cloud → APIs & Services → Credentials → Create API key, with "YouTube Data API v3" enabled. Read-only, public data.
# Used by STUDIO stats, the Video Scout, Autopilot, the learning loop (views of published clips) and comment reading.
YOUTUBE_API_KEY=
# Your channel for STUDIO stats: @handle, a UC… channel id, or a youtube.com/@handle URL. Needs YOUTUBE_API_KEY too.
YOUTUBE_CHANNEL=

# --- STUDIO analytics (optional): Google Cloud "Desktop app" OAuth client with YouTube Analytics + Data API enabled ---
# Like 1234-abc.apps.googleusercontent.com
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# LIFE → "Connect Google Calendar" (read-only) uses these unless you set its own client below (recommended: then disconnecting
# one never affects the other). Enable the Google Calendar API in whichever project the client belongs to.
GCAL_OAUTH_CLIENT_ID=
GCAL_OAUTH_CLIENT_SECRET=

# --- Git (optional, read-only): your repos for CORE "what did I change this week" and devlog scripts; semicolon-separated ---
ORBIT_GIT_REPOS=

# --- Safety ---
# Comma-separated emails allowed to use ORBIT. Anyone else is signed out. Leave empty to allow any signed-in user.
ORBIT_ALLOWED_EMAILS=
# Optional: folder for the YouTube token file (default %LOCALAPPDATA%\orbit)
# ORBIT_DATA_DIR=
# MCP plugins (Profile -> Plugins) live in <ORBIT_DATA_DIR>/plugins.json on this PC, tokens included; never in git or here. Blender: tools/blender/setup.ps1.

# --- Reach (optional): top Twitch clips of the streamers in 🌐 Reach sources, via Twitch's official Helix API ---
# Free: dev.twitch.tv/console → Register Your Application (Category: Other, OAuth redirect http://localhost) → Client ID + New Secret.
# App access token only (no Twitch login). Reddit, Kick and Bluesky need no key. Leave blank to skip Twitch.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# BUSINESS "Approve & send" (Resend). Without both, the button is hidden.
RESEND_API_KEY=
ORBIT_MAIL_FROM=
ORBIT_MAIL_REPLY_TO=

# --- AI Story (Clip Factory): Higgsfield via YOUR Claude Code MCP connector (no key here) ---
# One-time on this PC: claude mcp add -s user --transport http higgsfield https://mcp.higgsfield.ai/mcp ; then run claude, /mcp, sign in.
# Optional model ids (empty = gpt_image_2_5 / seedance_2_5 / seed_audio). Music bed: drop audio files in <studio>/music.
ORBIT_HIGGSFIELD_IMAGE_MODEL=
ORBIT_HIGGSFIELD_VIDEO_MODEL=
ORBIT_HIGGSFIELD_AUDIO_MODEL=
# 1 = fake Higgsfield (placeholder pictures, no credits, no network) for trying the pipeline
ORBIT_HIGGSFIELD_DRY_RUN=

# --- Phone remote (/remote over Tailscale, docs/PHONE.md) ---
# At least 32 random characters; empty = remote off. Make one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it unpairs every phone. Also needs SUPABASE_SECRET_KEY (above) so the phone's commands act as you.
REMOTE_SECRET=
# Phone notifications (Web Push to the paired Remote app). Empty = off. Make the pair: npm run remote:vapid
REMOTE_VAPID_PUBLIC=
REMOTE_VAPID_PRIVATE=
# Optional contact Apple/Google see in the push signature (mailto: or https:). Empty = mailto: the first ORBIT_ALLOWED_EMAILS
REMOTE_VAPID_SUBJECT=
# Phone notifications through ntfy (free app; works without Web Push). Topic empty = off. The topic is the only secret: use 16+ random
# characters, e.g. node -e "console.log('orbit-'+require('crypto').randomBytes(12).toString('hex'))". URL empty = https://ntfy.sh (or your own server).
ORBIT_NTFY_URL=
ORBIT_NTFY_TOPIC=
# Where the notification's Open button goes: ORBIT over Tailscale, e.g. https://your-pc.your-tailnet.ts.net:3000 (empty = no Open button).
# Also where Approve / Reject buttons post (single reversible agent approvals only; signed, 24 h, one use; needs SUPABASE_SECRET_KEY).
ORBIT_NTFY_OPEN_URL=
# Daily runs digest: the time (HH:MM, this PC) the brief / clips / leads states go to ntfy once a day. Empty = 10:30, off = never.
ORBIT_DAILY_DIGEST=
# Daily self-check: once a day from 09:00 (Tallinn) ORBIT runs its doctor and pushes once when something newly fails. Empty = on, off = never.
ORBIT_SELFCHECK=
# Agent approvals nobody answers count as rejected after this many hours (empty = 48, 0 = never expire). Never auto-approves.
ORBIT_APPROVAL_EXPIRY_HOURS=
# Quiet hours for phone notifications (Tallinn time), e.g. 23-8 (default) or off. Failures still come through.
ORBIT_QUIET_HOURS=
# Voice calls ("ORBIT wants to talk"): the Kokoro voice ORBIT uses on calls. Empty = af_heart
ORBIT_CALL_VOICE=
# Weekly Higgsfield credit cap (weeks start Monday 00:00 Tallinn time); Approve is refused past it. Empty = 10, 0 = no spending
ORBIT_HIGGSFIELD_WEEKLY_CAP=
# STUDIO music: original background music with ACE-Step on this PC (free; GPU). {prompt} {seconds} {out} become one argument each.
# ORBIT_ACESTEP_CMD=python C:\ACE-Step\generate.py --prompt {prompt} --duration {seconds} --output {out}
# Your own weekly Claude budget in calls, shown in the doctor's System card next to the 7-day use. Empty = no weekly budget shown
ORBIT_CLAUDE_WEEKLY_CALLS=

# --- Customer chat (self-hosted Chatwoot, docs/PC-CHECKLIST.md 4c): ORBIT drafts, you click Send ---
CHATWOOT_URL=
CHATWOOT_API_TOKEN=
# 16+ random chars; put it in the webhook URL as ?secret=. Empty = the webhook refuses everything.
CHATWOOT_WEBHOOK_SECRET=

# --- Advanced (optional): leave empty for the defaults. What each does: docs/SETUP.md ---
# Models for ORBIT's judgement calls (empty = opus) and quick chit-chat turns (empty = haiku)
ORBIT_MODEL_SMART=
ORBIT_MODEL_FAST=
# How many Claude Code CLIs may run at once. Empty = 3
ORBIT_CLAUDE_CONCURRENCY=
# Full path to chrome.exe/msedge.exe for reading web pages. Empty = installed Chrome, then Edge
ORBIT_BROWSER_PATH=
# Roblox Studio MCP (GAME DEV): the "command" and "args" of Roblox_Studio in Claude desktop's claude_desktop_config.json
ORBIT_ROBLOX_MCP_COMMAND=
ORBIT_ROBLOX_MCP_ARGS=
# Folder for Rojo projects exported from Studio (GAME DEV -> Build -> Files). Empty = Documents\RobloxProjects
ORBIT_ROBLOX_PROJECTS=
# Full path of selene if it is not in Rokit/Aftman/Foreman or PATH (the automatic code check after a Rojo export). Empty = look in the usual places.
ORBIT_SELENE=
# Whisper models. Voice input: empty = Xenova/whisper-small.en (English) and Xenova/whisper-small (other languages)
ORBIT_VOICE_WHISPER_MODEL=
ORBIT_VOICE_WHISPER_MULTI_MODEL=
# Clip Factory captions: empty = onnx-community/whisper-base_timestamped; _EN = an English-only model for English videos (empty = same)
ORBIT_WHISPER_MODEL=
ORBIT_WHISPER_MODEL_EN=
# e.g. q8: faster on CPU, slightly less accurate. Empty = the library default
ORBIT_WHISPER_DTYPE=
# Clip Factory transcription processes (empty = 1) and pieces transcribed in parallel (empty = same as workers)
ORBIT_ASR_WORKERS=
ORBIT_ASR_PARALLEL=
# Full path to yt-dlp.exe. Empty = yt-dlp on PATH
ORBIT_YTDLP=
# YouTube Data API units ORBIT may use per day (200-9000). Empty = 4000
ORBIT_YT_DAILY_UNITS=
# ORBIT twin: Higgsfield spends of at least this many credits get the case against before Approve. Empty = half the weekly cap
ORBIT_TWIN_SPEND_MIN=

# CORE model steps per turn (default 8, 2-12)
ORBIT_CORE_MAX_STEPS=
# CORE: "resume" keeps one Claude CLI session per CORE chat (default off = stateless)
ORBIT_CORE_SESSION=
# CORE engine: "mcp" = Claude Code's native tool loop with ORBIT's tools (core-mcp.ts); "sdk" = Claude Agent SDK prototype (docs/AGENT-SDK.md).
# Default = CORE's own JSON loop over claude -p. Profile → CORE engine overrides this.
ORBIT_CORE_ENGINE=
# CORE's independent verifier (verifier.ts): "off" disables it; ORBIT_MODEL_VERIFY picks its model (default = ORBIT_MODEL_FAST / haiku)
ORBIT_VERIFY=
ORBIT_MODEL_VERIFY=

# Plan my day: most hours of flexible work it plans per day (default 6; it never fills every free hour)
ORBIT_MAX_PLANNED_HOURS=

# Website photos: free AI pictures (Pollinations) are made at once for ws_picture_draft; "0" turns them off. A free key from
# Pollinations (optional) is tried first and gets better limits.
ORBIT_FREE_PICTURES=
POLLINATIONS_API_KEY=

# npm run eval (golden CORE tasks against the running ORBIT): the Cookie header of a signed-in ORBIT tab, and ORBIT's address (default http://127.0.0.1:3000)
ORBIT_EVAL_COOKIE=
ORBIT_EVAL_BASE=

# OPERATIONS → Team (Mission Control): read the agent team's Notion handoff board. A Notion internal integration's secret, with the
# board page shared to it, and the board's URL or id. Optional: the GitHub repo (owner/name) for PR links written as "#123".
ORBIT_NOTION_TOKEN=
ORBIT_TEAM_BOARD=
ORBIT_GITHUB_REPO=

# Security testing (scripts/isolated/strix.mjs, isolated copy only): Strix model and key, used by the strix CLI
STRIX_LLM=
LLM_API_KEY=

# Invoices "Create Stripe link" (his click only). Without it, he pastes a Stripe/PayPal link instead.
STRIPE_SECRET_KEY=
# Clip transcriber: Parakeet TDT v3 (default, downloads ~490 MB on first use) or "whisper" for the old one
ORBIT_ASR=
# Clip audio-event tagger (laughter, screams, cheers, applause, gasps, explosions; sherpa-onnx zipformer, ~110 MB download once): 0 turns it off
ORBIT_AUDIO_EVENTS=
# Shorts encoder: GPU (h264_nvenc) is used automatically when it works; 0 forces the CPU encoder
ORBIT_NVENC=
# Heavy GPU jobs at once (pictures, 3D models, NVENC renders) on the shared GPU; default 1, max 4
ORBIT_GPU_SLOTS=
# Efficiency switches (all on by default; set 0 to turn one off):
# query-embedding cache (CORE embeds each question once per 10 min)
ORBIT_EMBED_CACHE=
# article text cache for briefings and citation checks (6 h, readable results only)
ORBIT_ARTICLE_CACHE=
# keep ACE-Step/Wan loaded when the next GPU job is another music bed / video clip
ORBIT_GPU_KEEP_WARM=
# scheduler skips database reads whose answer can't have changed (briefing slots, proposals, owner list, approval expiry every 10 min)
ORBIT_SCHED_GATES=
# STUDIO tool check (ffmpeg, yt-dlp, transcriber) reused for 30 s when everything is installed
ORBIT_TOOLS_CACHE=
# Desk listener ("Hey Orbit" in any window) + local PC helper, tools/voice (setup.ps1 once, then Voice settings → Background "Hey Orbit").
# ORBIT_WAKE=0 keeps the listener off whatever the toggle says (the helper still answers ORBIT).
ORBIT_WAKE=
# Folders ORBIT may read, move/rename in, run npm test/build in, or (after your OK) delete from; separated by ;. Empty = none.
ORBIT_PC_FOLDERS=
# Extra apps "open X" may start, JSON {"name": "C:\\path\\app.exe"} (built-in: vs code, chrome, edge, roblox studio, blender, obs, spotify, ...).
ORBIT_PC_APPS=

# Night repair (night-repair.ts): once a night in the night-shift window, inside the usage pacer, up to 3 code patches (Opus agent,
# protected paths, npm run gate) that wait for your Approve in Needs you / the phone. 0 = off (default on).
ORBIT_NIGHT_REPAIR=
# Max patches per night (1-3, default 3) and Claude agent calls per night (1-20, default 6)
ORBIT_NIGHT_REPAIR_PATCHES=
ORBIT_NIGHT_REPAIR_CALLS=
# Opus model id for the repair agent (default opus; anything that isn't Opus is ignored, never Fable)
ORBIT_NIGHT_REPAIR_MODEL=
# GitHub token for pushing night branches + opening PRs (else `gh auth token`; neither = the branch stays local)
ORBIT_GITHUB_TOKEN=
# STUDIO job files parsed once until they change; the clip list answers 304 when nothing changed
ORBIT_JOB_CACHE=
ORBIT_CLIPS_ETAG=
# OPERATIONS → Agents counts grouped in the database (migration 0028) instead of reading every task
ORBIT_AGENT_COUNTS=
# scheduler: one shared "newest event" read per minute; missions/teams/goals resume checks pause while nothing is open
ORBIT_EVENTS_GATE=
ORBIT_RESUME_GATE=
# Mission Control in one request instead of five
ORBIT_MISSION_COMBINED=
# news feeds downloaded only when they changed (ETag / Last-Modified)
ORBIT_FEED_CONDITIONAL=
