# --- Supabase (Project Settings → API) ---
# Like https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# The anon (publishable) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- CORE runs on Claude Code under your own Claude login (no API key) ---
# Install Claude Code and run `claude` once to sign in. ORBIT must run on that same machine.
# Empty = sonnet
ORBIT_MODEL=
# Optional: model for CORE's "deep" answers to hard asks (planned, then self-checked). sonnet, opus, haiku,
# or fable / a claude-fable-* id only if your Claude plan has it. Default opus.
# ORBIT_MODEL_DEEP=opus
# Optional: Claude Code --effort for deep answers: low, medium, high, xhigh or max (empty = off). Default high.
# ORBIT_DEEP_EFFORT=high
# ORBIT_CLAUDE_BIN=claude
# Optional "offline brain": an Ollama model (e.g. llama3.1:8b) that answers CORE chat and background summaries when
# Claude is unreachable, rate-limited or on the usage hold. No tools in that mode. Empty = off. See README "Offline brain".
ORBIT_LOCAL_MODEL=

# --- Embeddings (optional but recommended) ---
# Optional. Anthropic has no embedding model; its docs recommend Voyage AI. Leave blank to use the free local model.
# Without this, ORBIT still works with full-text search only and no link suggestions.
# ORBIT_EMBED: local (free model on this PC) or voyage. Empty = Voyage when VOYAGE_API_KEY is set, else local.
ORBIT_EMBED=
VOYAGE_API_KEY=
# Empty = voyage-4
VOYAGE_MODEL=
# Empty = https://ai.mongodb.com/v1/embeddings
VOYAGE_API_URL=

# --- Scheduled briefings (Phase 2, optional) ---
# Supabase → Project Settings → API Keys → Secret keys → "default". Server-only: never share it or put it in NEXT_PUBLIC_*.
# Lets the Morning/Midday/Evening/Weekly briefings run while no browser is open. Leave blank to only brief on demand.
SUPABASE_SECRET_KEY=
# Weekly local backup folder (needs the secret key above). Default: orbit-backups next to the ORBIT folder.
ORBIT_BACKUP_DIR=

# --- Clip Factory (optional): folder with inbox/ (drop long videos here), clips/, jobs/, models/. Default: orbit-studio next to the ORBIT folder ---
ORBIT_STUDIO_DIR=
# Full path to ffmpeg.exe if you don't want the bundled ffmpeg-static one
ORBIT_FFMPEG=

# --- STUDIO channel stats + Video Scout (optional): YouTube Data API v3 key ---
# Google Cloud → APIs & Services → Credentials → Create API key, with "YouTube Data API v3" enabled. Read-only, public data.
# Used by STUDIO stats, the Video Scout, Autopilot, the learning loop (views of published clips) and comment reading.
YOUTUBE_API_KEY=
# Your channel for STUDIO stats: @handle, a UC… channel id, or a youtube.com/@handle URL. Needs YOUTUBE_API_KEY too.
YOUTUBE_CHANNEL=

# --- STUDIO analytics (optional): Google Cloud "Desktop app" OAuth client with YouTube Analytics + Data API enabled ---
# Like 1234-abc.apps.googleusercontent.com
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# LIFE → "Connect Google Calendar" (read-only) uses these unless you set its own client below (recommended: then disconnecting
# one never affects the other). Enable the Google Calendar API in whichever project the client belongs to.
GCAL_OAUTH_CLIENT_ID=
GCAL_OAUTH_CLIENT_SECRET=

# --- Git (optional, read-only): your repos for CORE "what did I change this week" and devlog scripts; semicolon-separated ---
ORBIT_GIT_REPOS=

# --- Safety ---
# Comma-separated emails allowed to use ORBIT. Anyone else is signed out. Leave empty to allow any signed-in user.
ORBIT_ALLOWED_EMAILS=
# Optional: folder for the YouTube token file (default %LOCALAPPDATA%\orbit)
# ORBIT_DATA_DIR=

# --- REA: optional local static project analysis (npm run rea:setup) ---
# Requires a real ORBIT_ALLOWED_EMAILS list above. Disabled until explicitly enabled.
# Empty = off; set to true to enable
ORBIT_REA_ENABLED=
# Optional absolute source directories, registered locally (JSON in single quotes):
# ORBIT_REA_TARGETS_JSON='{"orbit":"C:\\Users\\andre\\Documents\\orbit","notes":"D:\\projects\\notes"}'
# Default: bundled vendor/rea/scripts/rea.mjs after npm run rea:setup.
# Optional override for an existing separately installed REA scripts/rea.mjs.
# ORBIT_REA_ENTRYPOINT=C:/tools/rea/node_modules/rea-agents/scripts/rea.mjs

# --- Reach (optional): top Twitch clips of the streamers in 🌐 Reach sources, via Twitch's official Helix API ---
# Free: dev.twitch.tv/console → Register Your Application (Category: Other, OAuth redirect http://localhost) → Client ID + New Secret.
# App access token only (no Twitch login). Reddit, Kick and Bluesky need no key. Leave blank to skip Twitch.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# BUSINESS "Approve & send" (Resend). Without both, the button is hidden.
RESEND_API_KEY=
ORBIT_MAIL_FROM=
ORBIT_MAIL_REPLY_TO=

# --- AI Story (Clip Factory): Higgsfield via YOUR Claude Code MCP connector (no key here) ---
# One-time on this PC: claude mcp add -s user --transport http higgsfield https://mcp.higgsfield.ai/mcp ; then run claude, /mcp, sign in.
# Optional model ids (empty = gpt_image_2_5 / seedance_2_5 / seed_audio). Music bed: drop audio files in <studio>/music.
ORBIT_HIGGSFIELD_IMAGE_MODEL=
ORBIT_HIGGSFIELD_VIDEO_MODEL=
ORBIT_HIGGSFIELD_AUDIO_MODEL=
# 1 = fake Higgsfield (placeholder pictures, no credits, no network) for trying the pipeline
ORBIT_HIGGSFIELD_DRY_RUN=

# --- Phone remote (/remote over Tailscale, docs/PHONE.md) ---
# At least 32 random characters; empty = remote off. Make one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it unpairs every phone. Also needs SUPABASE_SECRET_KEY (above) so the phone's commands act as you.
REMOTE_SECRET=
# Phone notifications (Web Push to the paired Remote app). Empty = off. Make the pair: npm run remote:vapid
REMOTE_VAPID_PUBLIC=
REMOTE_VAPID_PRIVATE=
# Optional contact Apple/Google see in the push signature (mailto: or https:). Empty = mailto: the first ORBIT_ALLOWED_EMAILS
REMOTE_VAPID_SUBJECT=
# Voice calls ("ORBIT wants to talk"): the Kokoro voice ORBIT uses on calls. Empty = af_heart
ORBIT_CALL_VOICE=
# Weekly Higgsfield credit cap (weeks start Monday 00:00 Tallinn time); Approve is refused past it. Empty = 10, 0 = no spending
ORBIT_HIGGSFIELD_WEEKLY_CAP=

# --- Advanced (optional): leave empty for the defaults. What each does: docs/SETUP.md ---
# Models for ORBIT's judgement calls (empty = opus) and quick chit-chat turns (empty = haiku)
ORBIT_MODEL_SMART=
ORBIT_MODEL_FAST=
# How many Claude Code CLIs may run at once. Empty = 3
ORBIT_CLAUDE_CONCURRENCY=
# Full path to chrome.exe/msedge.exe for reading web pages. Empty = installed Chrome, then Edge
ORBIT_BROWSER_PATH=
# Roblox Studio MCP (GAME DEV): the "command" and "args" of Roblox_Studio in Claude desktop's claude_desktop_config.json
ORBIT_ROBLOX_MCP_COMMAND=
ORBIT_ROBLOX_MCP_ARGS=
# Whisper models. Voice input: empty = Xenova/whisper-small.en (English) and Xenova/whisper-small (other languages)
ORBIT_VOICE_WHISPER_MODEL=
ORBIT_VOICE_WHISPER_MULTI_MODEL=
# Clip Factory captions: empty = onnx-community/whisper-base_timestamped; _EN = an English-only model for English videos (empty = same)
ORBIT_WHISPER_MODEL=
ORBIT_WHISPER_MODEL_EN=
# e.g. q8: faster on CPU, slightly less accurate. Empty = the library default
ORBIT_WHISPER_DTYPE=
# Clip Factory transcription processes (empty = 1) and pieces transcribed in parallel (empty = same as workers)
ORBIT_ASR_WORKERS=
ORBIT_ASR_PARALLEL=
# Full path to yt-dlp.exe. Empty = yt-dlp on PATH
ORBIT_YTDLP=
# YouTube Data API units ORBIT may use per day (200-9000). Empty = 4000
ORBIT_YT_DAILY_UNITS=
# ORBIT twin: Higgsfield spends of at least this many credits get the case against before Approve. Empty = half the weekly cap
ORBIT_TWIN_SPEND_MIN=

# CORE model steps per turn (default 8, 2-12)
ORBIT_CORE_MAX_STEPS=
# CORE: "resume" keeps one Claude CLI session per CORE chat (default off = stateless)
ORBIT_CORE_SESSION=
