# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- CORE runs on Claude Code under your own Claude login (no API key) ---
# Install Claude Code and run `claude` once to sign in. ORBIT must run on that same machine.
ORBIT_MODEL=sonnet
# Optional: model for CORE's "deep" answers to hard asks (planned, then self-checked). sonnet, opus, haiku,
# or fable / a claude-fable-* id only if your Claude plan has it. Default opus.
# ORBIT_MODEL_DEEP=opus
# Optional: Claude Code --effort for deep answers: low, medium, high, xhigh or max (empty = off). Default high.
# ORBIT_DEEP_EFFORT=high
# ORBIT_CLAUDE_BIN=claude

# --- Embeddings (optional but recommended) ---
# Optional. Anthropic has no embedding model; its docs recommend Voyage AI. Leave blank for free keyword-only search.
# Without this, ORBIT still works with full-text search only and no link suggestions.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
VOYAGE_API_URL=https://ai.mongodb.com/v1/embeddings

# --- Scheduled briefings (Phase 2, optional) ---
# Supabase → Project Settings → API Keys → Secret keys → "default". Server-only: never share it or put it in NEXT_PUBLIC_*.
# Lets the Morning/Midday/Evening/Weekly briefings run while no browser is open. Leave blank to only brief on demand.
SUPABASE_SECRET_KEY=
# Weekly local backup folder (needs the secret key above). Default: orbit-backups next to the ORBIT folder.
ORBIT_BACKUP_DIR=

# --- Clip Factory (optional): folder with inbox/ (drop long videos here), clips/, jobs/, models/. Default: orbit-studio next to the ORBIT folder ---
ORBIT_STUDIO_DIR=
# Full path to ffmpeg.exe if you don't want the bundled ffmpeg-static one
ORBIT_FFMPEG=

# --- STUDIO analytics (optional): Google Cloud "Desktop app" OAuth client with YouTube Analytics + Data API enabled ---
YOUTUBE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_OAUTH_CLIENT_SECRET=your-client-secret
# LIFE → "Connect Google Calendar" (read-only) uses these unless you set its own client below (recommended: then disconnecting
# one never affects the other). Enable the Google Calendar API in whichever project the client belongs to.
GCAL_OAUTH_CLIENT_ID=
GCAL_OAUTH_CLIENT_SECRET=

# --- Git (optional, read-only): your repos for CORE "what did I change this week" and devlog scripts; semicolon-separated ---
ORBIT_GIT_REPOS=

# --- Safety ---
# Comma-separated emails allowed to use ORBIT. Anyone else is signed out. Leave empty to allow any signed-in user.
ORBIT_ALLOWED_EMAILS=you@example.com
# Optional: folder for the YouTube token file (default %LOCALAPPDATA%\orbit)
# ORBIT_DATA_DIR=

# --- REA: optional local static project analysis (npm run rea:setup) ---
# Requires a real ORBIT_ALLOWED_EMAILS list above. Disabled until explicitly enabled.
ORBIT_REA_ENABLED=false
# Optional absolute source directories, registered locally (JSON in single quotes):
# ORBIT_REA_TARGETS_JSON='{"orbit":"C:\\Users\\andre\\Documents\\orbit","notes":"D:\\projects\\notes"}'
# Default: bundled vendor/rea/scripts/rea.mjs after npm run rea:setup.
# Optional override for an existing separately installed REA scripts/rea.mjs.
# ORBIT_REA_ENTRYPOINT=C:/tools/rea/node_modules/rea-agents/scripts/rea.mjs

# --- Reach (optional): top Twitch clips of the streamers in 🌐 Reach sources, via Twitch's official Helix API ---
# Free: dev.twitch.tv/console → Register Your Application (Category: Other, OAuth redirect http://localhost) → Client ID + New Secret.
# App access token only (no Twitch login). Reddit, Kick and Bluesky need no key. Leave blank to skip Twitch.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
