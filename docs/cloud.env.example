# ORBIT cloud brain settings. Copy to deploy/cloud/.env on the server (chmod 600), fill in, never commit. Guide: docs/CLOUD.md.

# Your address. Its DNS A record points at the server; Caddy gets the HTTPS certificate for it.
ORBIT_DOMAIN=

# Supabase (same project as the laptop). The URL and anon key are public; the secret key is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Who may sign in (same as the laptop's .env.local).
ORBIT_ALLOWED_EMAILS=

# CORE on your Claude plan: on the laptop run `claude setup-token` once and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=

# Fixed by docker-compose: ORBIT_ROLE=cloud, ORBIT_DATA_DIR=/data. The GPU queue is always on in cloud mode.
# On the LAPTOP (.env.local) set ORBIT_GPU_QUEUE=1 so it works the jobs the cloud queues.

# Phone push (same values as the laptop, docs/PHONE.md), optional.
REMOTE_VAPID_PUBLIC=
REMOTE_VAPID_PRIVATE=
REMOTE_VAPID_SUBJECT=

# Optional: YouTube Data API key for STUDIO numbers / outliers.
YOUTUBE_API_KEY=

# Journal key: leave empty. The key stays on the laptop and the cloud can't read or write the journal.
# Only if you choose to: ORBIT_JOURNAL_KEY_FILE=/data/keys/journal.key (copy the file into the volume yourself).
ORBIT_JOURNAL_KEY_FILE=
