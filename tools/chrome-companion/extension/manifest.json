{
  "manifest_version": 3,
  "name": "ORBIT Companion",
  "version": "1.0.0",
  "description": "Keep a one-click ORBIT chat button on YouTube.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
