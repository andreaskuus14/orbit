{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "description": "ORBIT — your mind has a universe. Phase 1: auth, galaxy, CORE chat, memory.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "eval:ai": "node --experimental-strip-types scripts/ai-scorecard.ts",
    "eval:agents": "node --experimental-strip-types scripts/agent-evals.ts",
    "eval": "node --no-warnings --experimental-strip-types scripts/eval-core.ts",
    "demo:build": "node scripts/demo-build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check:watch-brief": "node --no-warnings --experimental-strip-types scripts/watch-brief-ui.mjs",
    "check:team-status": "node --no-warnings --experimental-strip-types scripts/team-status-ui.mjs",
    "check:continue-work": "node --no-warnings --experimental-strip-types scripts/continue-ui.mjs",
    "secrets": "node scripts/secret-scan.mjs",
    "deps:outdated": "node scripts/deps-update.mjs",
    "gate": "node scripts/secret-scan.mjs && node -e \"require('fs').rmSync('.next/types',{recursive:true,force:true})\" && tsc --noEmit -p . && npm test && npm run eval:ai && next build",
    "textures": "node scripts/fetch-textures.mjs",
    "app:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1",
    "app:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch.ps1 -ServerOnly",
    "app:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch.ps1 -Dev",
    "app:rebuild": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch.ps1 -Rebuild -ServerOnly",
    "app:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "app:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1 -Autostart",
    "app:autostart-off": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcut.ps1 -RemoveAutostart",
    "wake:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/wake/install.ps1",
    "wake:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/wake/uninstall.ps1",
    "wake:run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/wake/orbit-wake.ps1",
    "wake:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/wake/orbit-wake.ps1 -DebugRun",
    "night:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/night/install.ps1",
    "night:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/night/uninstall.ps1",
    "remote:vapid": "node --experimental-strip-types scripts/vapid-keys.ts",
    "perf:run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/perf-run.ps1",
    "perf:report": "node --no-warnings --experimental-strip-types scripts/perf-run.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@huggingface/transformers": "^3.7.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@puckeditor/core": "^0.24.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "@react-three/postprocessing": "^3.0.4",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.75.0",
    "ajv": "8.20.0",
    "ffmpeg-static": "^5.2.0",
    "kokoro-js": "^1.2.1",
    "mammoth": "^1.9.0",
    "next": "^15.5.0",
    "playwright-core": "^1.55.0",
    "postprocessing": "^6.37.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.3",
    "three": "^0.180.0",
    "unpdf": "^1.0.0",
    "web-ifc": "0.0.78",
    "world-atlas": "^2.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "hyperframes": "0.8.171",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "sharp@0.35.5": true,
    "sharp@0.34.5": true,
    "esbuild@0.25.12": true,
    "onnxruntime-node@1.21.0": true,
    "protobufjs@7.6.6": true
  }
}
